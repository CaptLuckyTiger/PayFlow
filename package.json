{
  "name": "payflow",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "npm -w apps/api run start:dev",
    "dev:worker": "npm -w apps/worker run start:dev",
    "build": "npm run build:shared && npm run build:api && npm run build:worker",
    "build:shared": "npm -w packages/shared run build",
    "build:api": "npm -w apps/api run build",
    "build:worker": "npm -w apps/worker run build",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "test:unit": "npm run build:shared && jest --config apps/api/test/unit/jest.config.js --runInBand",
    "test:integration": "npm run build:shared && jest --config apps/api/test/integration/jest.config.js --runInBand",
    "test:e2e": "npm run build:shared && jest --config apps/api/test/e2e/jest.config.js --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.22",
    "@types/cors": "^2.8.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-nestjs": "^1.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.0.1",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^5.1.2",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.8.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.3.2",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.6.0",
    "supertest": "^7.0.0",
    "uuid": "^11.0.0"
  }
}
