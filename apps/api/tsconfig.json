{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "incremental": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node", "jest"],
    "paths": {
      "@payflow/shared": ["../../packages/shared/dist/index.d.ts"],
      "@payflow/shared/*": ["../../packages/shared/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts"]
}
